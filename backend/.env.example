# ============================================================
# backend/.env.example — Template environment variables
# Salin: cp .env.example .env
# JANGAN commit .env ke git!
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://mirza:devpassword@localhost:5432/nusanara_dev

# ── Clerk Auth ───────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_NUM_THREAD=8
OLLAMA_KEEP_ALIVE=-1

# ── Config RAG ───────────────────────────────────────────────
RAG_TOP_K=10
RAG_RERANK_TOP_N=3

# ── App ──────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
