{
  "version": 2,
  "public": true,
  "name": "nusanara-mockup",
  "rewrites": [
    { "source": "/", "destination": "/frontend/mockups/index.html" },
    { "source": "/auth", "destination": "/frontend/mockups/auth.html" },
    { "source": "/dashboard", "destination": "/frontend/mockups/dashboard.html" },
    { "source": "/rekomendasi", "destination": "/frontend/mockups/rekomendasi.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/mockups/assets/$1" }
  ],
  "cleanUrls": true
}
